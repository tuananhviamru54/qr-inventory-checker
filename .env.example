# Tài khoản MISA AMIS (nên tạo 1 tài khoản riêng chỉ có quyền XEM báo cáo)
AMIS_USERNAME=
AMIS_PASSWORD=
# (Tuỳ chọn) Tên dữ liệu kế toán cần chọn sau khi đăng nhập, ví dụ: "KHO QUẢNG NINH"
AMIS_TARGET_DB=
# Cũng chấp nhận tên biến MISA_WEB_USERNAME / MISA_WEB_PASSWORD / MISA_WEB_TARGET_DB
# (Tuỳ chọn) Khoá bí mật TOTP nếu tài khoản bật xác thực 2 lớp bằng ứng dụng Authenticator
AMIS_TOTP_SECRET=

# Telegram: tạo bot bằng @BotFather, lấy chat id bằng @userinfobot hoặc getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Tuỳ chọn) Khoá Claude API để bật 3 agent AI: trợ lý trả lời, kế toán trưởng kiểm soát, giám sát phân loại.
# Lấy tại https://platform.claude.com — không có khoá thì bot vẫn chạy /baocao với luật cứng.
ANTHROPIC_API_KEY=
