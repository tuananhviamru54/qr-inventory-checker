  ],
  "checks": [
    {
      "id": "amis_vs_kiem_ke",
      "name": "Tồn kho AMIS ↔ kiểm kê thực tế",
      "type": "compare",
      "left": "ton_kho",
      "right": "kiem_ke",
      "key": [
        "ma_hang"
      ],
      "columns": [
        {
          "left": "sl_cuoi_ky",
          "right": "sl_thuc_te",
          "label": "SL",
          "tolerance": 0
        }
      ]
    },
    {
      "id": "can_doi_nxt",
      "name": "Cân đối đầu kỳ + nhập − xuất = cuối kỳ",
      "type": "balance",
      "source": "ton_kho",
      "key": [
        "ma_hang"
      ],
      "plus": [
        "sl_dau_ky",
        "sl_nhap"
      ],
      "minus": [
        "sl_xuat"
      ],
      "equals": "sl_cuoi_ky",
      "tolerance": 0.0001
    },
    {
      "id": "ton_am",
      "name": "Tồn kho âm",
      "type": "negative",
      "source": "ton_kho",
      "key": [
        "ma_hang"
      ],
      "columns": [
        "sl_cuoi_ky"
      ]
    }
  ],
  "ai": {
    "enabled": false
  }
}
