{
  "title": "Báo cáo đối chiếu tồn kho MISA AMIS",
  "period": "thisMonth",
  "maxLinesPerCheck": 10,
  "attachSourceFiles": false,
  "amis": {
    "baseUrl": "https://actapp.misa.vn/app",
    "timeoutMs": 30000,
    "readOnly": {
      "allowPost": [
        "/api/export/v1/export/save_param$"
      ]
    },
    "selectors": {},
    "downloadTimeoutMs": 90000
  },
  "sources": [
    {
      "id": "ton_kho",
      "name": "Tồn kho AMIS",
      "type": "amis",
      "steps": [
        {
          "goto": "https://actapp.misa.vn/app/RP/ReportList/RPDynamicViewer/INInventoryBalanceSummary"
        },
        {
          "waitFor": "button:has-text('Chọn tham số')"
        },
        {
          "wait": 3000
        },
        {
          "click": {
            "selector": "button:has-text('Chọn tham số')",
            "unlessVisible": "button:has-text('Xem báo cáo')"
          }
        },
        {
          "waitFor": "button:has-text('Xem báo cáo')"
        },
        {
          "dateRange": {
            "from": "input.input-date >> nth=0",
            "to": "input.input-date >> nth=1",
            "fromValue": "{{fromDate}}",
            "toValue": "{{toDate}}"
          }
        },
        {
          "ensureChecked": "[data-testid='sme_iibsp_mschk_isselectallstock']"
        },
        {
          "wait": 1500
        },
        {
          "click": "button:has-text('Xem báo cáo')"
        },
        {
          "waitGone": "button:has-text('Xem báo cáo')"
        },
        {
          "waitFor": "text=Tổng số"
        },
        {
          "wait": 3000
        },
        {
          "click": "[data-testid='sme_iibdv_msrph_reportheader-msdd-raction-btn-buttonsubclick']"
        },
        {
          "wait": 1500
        },
        {
          "click": "text=Xuất Excel (dạng dữ liệu)"
        },
        {
          "click": {
            "selector": "button:visible:has-text('Đồng ý')",
            "optional": true,
            "timeout": 15000
          }
        },
        {
          "waitFor": "text=\"Tải tệp\""
        },
        {
          "download": {
            "selector": "text=\"Tải tệp\"",
            "response": "/file-access/download"
          }
        }
      ],
      "parse": {
        "key": [
          "ma_hang"
        ],
        "fields": {
          "ten_kho": {
            "headers": [
              "Tên kho",
              "Kho"
            ],
            "type": "text"
          },
          "ma_hang": {
            "headers": [
              "Mã hàng",
              "Mã VTHH",
              "Mã vật tư",
              "Mã hàng hóa"
            ],
            "type": "text"
          },
          "ten_hang": {
            "headers": [
              "Tên hàng",
              "Tên VTHH",
              "Tên vật tư",
              "Tên hàng hóa"
            ],
            "type": "text"
          },
          "sl_dau_ky": {
            "headers": [
              "Đầu kỳ Số lượng",
              "Tồn đầu kỳ Số lượng",
              "SL đầu kỳ"
            ]
          },
          "sl_nhap": {
            "headers": [
              "Nhập kho Số lượng",
              "Nhập trong kỳ Số lượng",
              "Nhập Số lượng",
              "SL nhập"
            ]
          },
          "sl_xuat": {
            "headers": [
              "Xuất kho Số lượng",
              "Xuất trong kỳ Số lượng",
              "Xuất Số lượng",
              "SL xuất"
            ]
          },
          "sl_cuoi_ky": {
            "headers": [
              "Cuối kỳ Số lượng",
              "Tồn cuối kỳ Số lượng",
              "Số lượng tồn",
              "SL tồn",
              "SL cuối kỳ"
            ]
          }
        }
      }
    },
    {
      "id": "kiem_ke",
      "name": "Kiểm kê thực tế",
      "type": "file",
      "path": "data/kiem_ke.xlsx",
      "parse": {
        "key": [
          "ma_hang"
        ],
        "fields": {
          "ma_hang": {
            "headers": [
              "Mã hàng",
              "Mã",
              "Mã SP",
              "Mã sản phẩm",
              "Mã VTHH"
            ],
            "type": "text"
          },
          "ten_hang": {
            "headers": [
              "Tên hàng",
              "Tên",
              "Tên sản phẩm"
            ],
            "type": "text"
          },
          "sl_thuc_te": {
            "headers": [
              "Số lượng thực tế",
              "SL thực tế",
              "Số lượng kiểm kê",
              "Số lượng",
              "SL"
            ]
          }
        }
      }
    },
    {
      "id": "doanh_so",
      "name": "Doanh số theo mặt hàng",
      "type": "amis",
      "onDemand": true,
      "steps": [
        {
          "goto": "https://actapp.misa.vn/app/RP/ReportList/RPDynamicViewer/SalesSummaryByInventory"
        },
        {
          "waitFor": "button:has-text('Chọn tham số')"
        },
        {
          "wait": 3000
        },
        {
          "click": {
            "selector": "button:has-text('Chọn tham số')",
            "unlessVisible": "button:has-text('Xem báo cáo')"
          }
        },
        {
          "waitFor": "button:has-text('Xem báo cáo')"
        },
        {
          "dateRange": {
            "from": "input.input-date >> nth=0",
            "to": "input.input-date >> nth=1",
            "fromValue": "{{fromDate}}",
            "toValue": "{{toDate}}"
          }
        },
        {
          "setGroups": {
            "prefix": "sme_ssbip_mscm2_p_iic_misa_code_id",
            "values": "{{groups}}"
          }
        },
        {
          "ensureChecked": "label:has-text('Chọn tất cả vật tư')"
        },
        {
          "wait": 1500
        },
        {
          "click": "button:has-text('Xem báo cáo')"
        },
        {
          "waitGone": "button:has-text('Xem báo cáo')"
        },
        {
          "waitForResult": {
            "found": "text=Tổng số",
            "empty": "text=Không có dữ liệu"
          }
        },
        {
          "wait": 3000
        },
        {
          "click": "[data-testid$='-msdd-raction-btn-buttonsubclick']"
        },
        {
          "wait": 1500
        },
        {
          "click": "text=Xuất Excel (dạng dữ liệu)"
        },
        {
          "click": {
            "selector": "button:visible:has-text('Đồng ý')",
            "optional": true,
            "timeout": 15000
          }
        },
        {
          "waitFor": "text=\"Tải tệp\""
        },
        {
          "download": {
            "selector": "text=\"Tải tệp\"",
            "response": "/file-access/download"
          }
        }
      ],
      "parse": {
        "key": [
          "ma_hang"
        ],
        "fields": {
          "ma_hang": {
            "headers": [
              "Mã hàng",
              "Mã VTHH",
              "Mã vật tư"
            ],
            "type": "text"
          },
          "ten_hang": {
            "headers": [
              "Tên hàng",
              "Tên VTHH",
              "Tên vật tư"
            ],
            "type": "text"
          },
          "sl_ban": {
            "headers": [
              "Số lượng bán",
              "SL bán"
            ]
          },
          "doanh_so": {
            "headers": [
              "Doanh số bán"
            ]
          },
          "chiet_khau": {
            "headers": [
              "Chiết khấu"
            ]
          },
          "sl_tra": {
            "headers": [
              "SL trả lại",
              "Số lượng trả lại"
            ]
          },
          "gia_tri_tra": {
            "headers": [
              "Giá trị trả lại"
            ]
          },
          "giam_gia": {
            "headers": [
              "Giá trị giảm giá",
              "Giảm giá"
            ]
          },
          "doanh_thu": {
            "headers": [
              "Doanh thu thuần",
              "Doanh thu"
            ]
          },
          "tien_von": {
            "headers": [
              "Tiền vốn"
            ]
          },
          "lai_gop": {
            "headers": [
              "Lãi gộp"
            ]
          }
        }
      },
      "groups": {
        "prefix": "sme_ssbip_mscm2_p_iic_misa_code_id",
        "file": "data/nhom_vthh.json"
      }
    },
